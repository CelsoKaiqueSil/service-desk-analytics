Chamados = COUNTROWS(FactTickets)

Resolvidos = COUNTROWS(FILTER(FactTickets, NOT ISBLANK(FactTickets[SolutionHours])))

Backlog snapshot = CALCULATE([Chamados], FactTickets[Status] IN {"Aberto", "Em andamento"})

SLA elegiveis = CALCULATE([Chamados], FactTickets[SLAEligible] = TRUE())

SLA cumpridos = CALCULATE([Chamados], FactTickets[SLAMet] = TRUE())

SLA percentual = DIVIDE([SLA cumpridos], [SLA elegiveis])

Resposta media h = AVERAGE(FactTickets[ResponseHours])

Resposta mediana h = MEDIAN(FactTickets[ResponseHours])

Solucao P90 h = PERCENTILEX.INC(FILTER(FactTickets, NOT ISBLANK(FactTickets[SolutionHours])), FactTickets[SolutionHours], 0.9)

Chamados mes anterior = CALCULATE([Chamados], DATEADD(DimDate[Date], -1, MONTH))

Resolvidos por data = CALCULATE([Resolvidos], USERELATIONSHIP(FactTickets[ResolvedDateKey], DimDate[DateKey]))
